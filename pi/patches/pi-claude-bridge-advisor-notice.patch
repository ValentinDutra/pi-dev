+function configuredAdvisorModel(): string {
+	try {
+		return JSON.parse(readFileSync(join(homedir(), ".claude", "settings.json"), "utf8")).advisorModel ?? "advisor";
+	} catch {
+		return "advisor";
+	}
+}
+
+// The advisor runs server-side, so pi never sees it as a tool call. Show each consultation as its
+// own text block. Claude Code returns the advice itself encrypted (advisor_redacted_result) unless
+// the advisor produced readable text (advisor_result).
+function pushAdvisorNotice(c: QueryContext, result: { type?: string; text?: string; error_code?: string } | undefined): void {
+	const heading = `**Advisor consulted (${configuredAdvisorModel()})**`;
+	const text = result?.type === "advisor_result" && result.text
+		? `> ${heading}\n>\n> ${result.text.replace(/\n/g, "\n> ")}\n\n`
+		: result?.error_code
+			? `> ${heading}: unavailable (${result.error_code})\n\n`
+			: `> ${heading}\n\n`;
+	ensureTurnStarted(c);
+	c.turnBlocks.push({ type: "text", text });
+	const contentIndex = c.turnBlocks.length - 1;
+	c.currentPiStream!.push({ type: "text_start", contentIndex, partial: c.turnOutput });
+	c.currentPiStream!.push({ type: "text_delta", contentIndex, delta: text, partial: c.turnOutput });
+	c.currentPiStream!.push({ type: "text_end", contentIndex, content: text, partial: c.turnOutput });
+}
